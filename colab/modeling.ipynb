    "    pretrained_model = SentenceTransformer(config.base_model_name, device=config.device)\n",
    "    pretrained_matrix = build_embedding_similarity_matrix(pretrained_model, resumes, jobs, config.batch_size)\n",
    "    finetuned_matrix = build_embedding_similarity_matrix(finetuned_model, resumes, jobs, config.batch_size)\n",
    "\n",
